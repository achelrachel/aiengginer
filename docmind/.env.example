APP_ENV=development
API_KEY=dev-key-change-me
DATABASE_URL=sqlite+aiosqlite:///./data/docmind.db
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
CHROMADB_DIR=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Text-generation provider: ollama | openai | xai | compatible
LLM_PROVIDER=ollama
# Cloud providers require an exact model ID available to your API account.
# LLM_MODEL=
# Set ONE applicable secret on the server; never commit actual key values.
# OPENAI_API_KEY=
# XAI_API_KEY=
# LLM_API_KEY=
# Compatible gateway only (API base, already versioned):
# LLM_BASE_URL=https://gateway.example/v1
# For model-specific API compatibility:
# LLM_TOKEN_PARAMETER=max_completion_tokens
# LLM_OUTPUT_MODE=json_schema
# LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
